PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=15m
REFRESH_SECRET=your_refresh_secret
REFRESH_EXPIRE=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/oauth/callback

# Email & Verification Settings (Phase 6C Email Verification)
# If SMTP_HOST is omitted/empty in development, verification links are output to dev console for local testing.
# In production, SMTP_HOST/USER/PASS must be configured and token links are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AIRA <noreply@aira.dev>"
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_HOURS=24
